#!/usr/bin/env bash
# Volume control + waybar status. Honest scale: display 100% = raw 1.0 = 0 dB.
# Capped at 1.0 — software gain above 0 dB just clips into the T2 speaker DSP
# limiter (compressed/distorted, not louder).

set -euo pipefail

SINK="@DEFAULT_AUDIO_SINK@"
RAW_MAX="1.0"
STEP=5            # %

case "${1:-status}" in
    status)
        out=$(wpctl get-volume "$SINK")
        raw=$(awk '{print $2}' <<<"$out")
        display=$(awk -v v="$raw" 'BEGIN { printf "%d", (v * 100) + 0.5 }')
        if grep -q MUTED <<<"$out"; then
            printf '{"text":" Muted","tooltip":"Muted","class":"muted","percentage":%d}\n' "$display"
        else
            if   (( display <= 33 )); then icon="󰕿"   # 󰕿
            elif (( display <= 66 )); then icon="󰖀"   # 󰖀
            else                            icon="󰕾"  # 󰕾
            fi
            printf '{"text":"%b %d%%","tooltip":"Volume: %d%%","percentage":%d}\n' \
                "$icon" "$display" "$display" "$display"
        fi
        ;;
    up)
        wpctl set-mute "$SINK" 0
        wpctl set-volume -l "$RAW_MAX" "$SINK" "${STEP}%+"
        pkill -SIGRTMIN+8 waybar 2>/dev/null || true
        ;;
    down)
        wpctl set-volume "$SINK" "${STEP}%-"
        pkill -SIGRTMIN+8 waybar 2>/dev/null || true
        ;;
    toggle)
        wpctl set-mute "$SINK" toggle
        pkill -SIGRTMIN+8 waybar 2>/dev/null || true
        ;;
    *)
        echo "usage: $0 {status|up|down|toggle}" >&2
        exit 2
        ;;
esac

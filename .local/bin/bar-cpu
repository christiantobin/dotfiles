#!/bin/bash
# CPU usage % for the bar (delta since the last call).
state="${XDG_RUNTIME_DIR:-/tmp}/bar-cpu.prev"
read -r _ u n s i w irq sirq _ < /proc/stat
total=$((u + n + s + i + w + irq + sirq)); idle=$((i + w))
if [[ -f $state ]]; then
  read -r pt pi < "$state"
  dt=$((total - pt)); di=$((idle - pi))
  (( dt > 0 )) && pct=$(( (100 * (dt - di)) / dt )) || pct=0
else
  pct=0
fi
echo "$total $idle" > "$state"
printf '󰻠 %d%%\n' "$pct"

#!/usr/bin/env bash
# theme-switch — switch Hyprland themes from ~/repos/hypr-themes/
set -euo pipefail

THEMES_DIR="$HOME/repos/hypr-themes"
BACKUP_DIR="$HOME/.config/hypr-backup"
DEFAULT_BACKUP="$BACKUP_DIR/default"
CONFIG_DIR="$HOME/.config"

# Config directories that themes can replace
SWAPPABLE=(hypr waybar wofi alacritty)

# Files in hypr/ that are never overwritten by themes
PRESERVE_PATTERNS=(
    "keybinds"
    "monitor"
    "autostart"
)

die() { echo "error: $1" >&2; exit 1; }

# --- Find manifest for a theme ---
find_manifest() {
    local name="$1"
    # Check manifests/ dir first, then inside theme dir
    local m="$THEMES_DIR/manifests/${name}.toml"
    [[ -f "$m" ]] && echo "$m" && return
    m="$THEMES_DIR/$name/theme.toml"
    [[ -f "$m" ]] && echo "$m" && return
}

# --- Collect available themes ---
themes=()
# From manifests/ directory
for m in "$THEMES_DIR"/manifests/*.toml; do
    [[ -f "$m" ]] || continue
    name="$(basename "$m" .toml)"
    themes+=("$name")
done
# From theme dirs (if not already found via manifest)
for m in "$THEMES_DIR"/*/theme.toml; do
    [[ -f "$m" ]] || continue
    name="$(basename "$(dirname "$m")")"
    [[ " ${themes[*]} " == *" $name "* ]] || themes+=("$name")
done

[[ ${#themes[@]} -eq 0 ]] && die "no themes found in $THEMES_DIR"

# Build wofi menu: default first, then themes
menu="default (restore original)"
for t in "${themes[@]}"; do
    local_manifest=$(find_manifest "$t")
    label=$(grep -Po '(?<=^name = ").*(?=")' "$local_manifest" 2>/dev/null || echo "$t")
    menu+=$'\n'"$t ($label)"
done

# --- Pick via wofi (or fzf in terminal fallback) ---
if command -v wofi &>/dev/null && [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    choice=$(echo "$menu" | wofi --dmenu --prompt "Theme" --width 400 --height 300) || exit 0
else
    choice=$(echo "$menu" | fzf --prompt "Theme > ") || exit 0
fi

selected="${choice%% (*}"  # strip parenthetical

# --- Parse theme.toml (simple key=value reader) ---
read_manifest() {
    local manifest="$1" key="$2"
    grep -Po "(?<=^${key} = \").*(?=\")" "$manifest" 2>/dev/null
}

# --- Backup current config ---
backup_current() {
    echo ":: Backing up current config to $BACKUP_DIR/$(date +%Y%m%d-%H%M%S)"
    local stamp
    stamp="$BACKUP_DIR/$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$stamp"
    for dir in "${SWAPPABLE[@]}"; do
        [[ -d "$CONFIG_DIR/$dir" ]] && cp -a "$CONFIG_DIR/$dir" "$stamp/"
    done

    # Save initial default if it doesn't exist yet
    if [[ ! -d "$DEFAULT_BACKUP" ]]; then
        echo ":: Saving current config as default (first run)"
        mkdir -p "$DEFAULT_BACKUP"
        for dir in "${SWAPPABLE[@]}"; do
            [[ -d "$CONFIG_DIR/$dir" ]] && cp -a "$CONFIG_DIR/$dir" "$DEFAULT_BACKUP/"
        done
    fi
}

# --- Preserve user's personal hypr settings ---
save_preserved() {
    local tmpdir
    tmpdir=$(mktemp -d)
    if [[ -d "$CONFIG_DIR/hypr" ]]; then
        # Save files matching preserve patterns
        for pattern in "${PRESERVE_PATTERNS[@]}"; do
            find "$CONFIG_DIR/hypr" -maxdepth 1 -name "*${pattern}*" -exec cp -a {} "$tmpdir/" \; 2>/dev/null
        done
        # Always save monitor line and keybinds from main conf
        grep -E '^(monitor|source.*keybind|source.*monitor|source.*autostart)' \
            "$CONFIG_DIR/hypr/hyprland.conf" > "$tmpdir/_preserved_lines" 2>/dev/null || true
    fi
    echo "$tmpdir"
}

restore_preserved() {
    local tmpdir="$1"
    # Copy back preserved files
    find "$tmpdir" -maxdepth 1 -not -name '_preserved_lines' -not -name "$(basename "$tmpdir")" \
        -exec cp -a {} "$CONFIG_DIR/hypr/" \; 2>/dev/null

    # Re-inject monitor and autostart lines into hyprland.conf if theme overwrote them
    if [[ -f "$tmpdir/_preserved_lines" && -s "$tmpdir/_preserved_lines" ]]; then
        local conf="$CONFIG_DIR/hypr/hyprland.conf"
        # Remove theme's monitor lines, then prepend ours
        sed -i '/^monitor\s*=/d' "$conf" 2>/dev/null
        local preserved
        preserved=$(cat "$tmpdir/_preserved_lines")
        printf '%s\n\n' "$preserved" | cat - "$conf" > "$conf.tmp" && mv "$conf.tmp" "$conf"
    fi
    rm -rf "$tmpdir"
}

# --- Apply theme ---
apply_theme() {
    local theme_name="$1"
    local theme_dir="$THEMES_DIR/$theme_name"
    local manifest
    manifest=$(find_manifest "$theme_name")

    for target in "${SWAPPABLE[@]}"; do
        local src
        src=$(read_manifest "$manifest" "$target")
        [[ -z "$src" ]] && continue
        src="$theme_dir/$src"
        [[ -d "$src" ]] || continue

        echo ":: Applying $target from $theme_name"
        # For hypr, preserve keybinds, monitor, and autostart
        if [[ "$target" == "hypr" ]]; then
            # Save protected files
            local tmpdir
            tmpdir=$(mktemp -d)
            for pattern in "${PRESERVE_PATTERNS[@]}"; do
                find "$CONFIG_DIR/$target" -name "*${pattern}*" -exec cp -a --parents {} "$tmpdir/" \; 2>/dev/null
            done
            rm -rf "$CONFIG_DIR/$target"
            cp -a "$src" "$CONFIG_DIR/$target"
            # Restore protected files over theme's versions
            if [[ -d "$tmpdir/$CONFIG_DIR/$target" ]]; then
                cp -a "$tmpdir/$CONFIG_DIR/$target"/. "$CONFIG_DIR/$target/"
            fi
            rm -rf "$tmpdir"
        else
            rm -rf "$CONFIG_DIR/$target"
            cp -a "$src" "$CONFIG_DIR/$target"
        fi
    done
}

restore_default() {
    [[ -d "$DEFAULT_BACKUP" ]] || die "no default backup found — run theme-switch once with a theme first"
    echo ":: Restoring default config"
    for dir in "${SWAPPABLE[@]}"; do
        if [[ -d "$DEFAULT_BACKUP/$dir" ]]; then
            rm -rf "$CONFIG_DIR/$dir"
            cp -a "$DEFAULT_BACKUP/$dir" "$CONFIG_DIR/$dir"
        fi
    done
}

# --- Main ---
backup_current
preserved=$(save_preserved)

if [[ "$selected" == "default" ]]; then
    restore_default
else
    [[ -n "$(find_manifest "$selected")" ]] || die "theme '$selected' has no manifest"
    apply_theme "$selected"
    restore_preserved "$preserved"
fi

# --- Reload ---
echo ":: Reloading Hyprland and waybar"
hyprctl reload 2>/dev/null || true
pkill -SIGUSR2 waybar 2>/dev/null || { nohup waybar &>/dev/null & }

echo "$selected" > "$HOME/.config/hypr/current_theme"
echo ":: Done! Theme '$selected' applied."

/* Matugen-generated rofi colors */
/* Do not edit — regenerated on wallpaper change */

* {
    bg:             {{colors.surface.default.hex}};
    bg-alt:         {{colors.surface_variant.default.hex}};
    fg:             {{colors.on_surface.default.hex}};
    fg-alt:         {{colors.on_surface_variant.default.hex}};
    accent:         {{colors.primary.default.hex}};
    accent-alt:     {{colors.primary_container.default.hex}};
    urgent:         {{colors.error.default.hex}};
    selected-bg:    {{colors.primary_container.default.hex}};
    selected-fg:    {{colors.on_primary_container.default.hex}};
}

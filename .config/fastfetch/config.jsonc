{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    {
      "type": "command",
      "key": "Shell Theme",
      "text": "echo ${OSH_THEME:-none}"
    },
    "display",
    "de",
    "wm",
    {
      "type": "command",
      "key": "WM Theme",
      "text": "cat $HOME/.config/hypr/current_theme 2>/dev/null || echo default"
    },
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}

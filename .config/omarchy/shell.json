{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.media"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.indicators",
          "alwaysShow": true
        },
        {
          "id": "tobin-omarchy.workspaces"
        },
        {
          "id": "omarchy.active-window"
        }
      ],
      "right": [
        {
          "id": "omarchy.agents"
        },
        {
          "id": "custom.cpu",
          "exec": "~/.local/bin/bar-cpu",
          "interval": 2,
          "onClick": "omarchy-launch-tui btop",
          "tooltip": "CPU usage",
          "group": "perf"
        },
        {
          "id": "custom.mem",
          "exec": "~/.local/bin/bar-mem",
          "interval": 3,
          "onClick": "omarchy-launch-tui btop",
          "tooltip": "Memory usage",
          "group": "perf"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth",
          "group": "conn"
        },
        {
          "id": "omarchy.network",
          "group": "conn"
        },
        {
          "id": "omarchy.audio",
          "group": "conn"
        },
        {
          "id": "omarchy.monitor",
          "group": "sys"
        },
        {
          "id": "omarchy.power",
          "group": "sys"
        }
      ]
    },
    "position": "top",
    "transparent": true,
    "id": "tobin-omarchy.bar"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1
}

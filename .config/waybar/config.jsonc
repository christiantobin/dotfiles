{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-left": 10,
  "margin-right": 10,
  "margin-top": 5,
  "spacing": 10,
  "reload_style_on_change": true,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["custom/window"],
  "modules-right": [
    "tray",
    "mpris",
    "network",
    "custom/volume",
    "backlight",
    "battery",
    "clock"
  ],

  "tray": {
    "icon-size": 18,
    "spacing": 8
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "all-outputs": true,
    "format": "{id}",
    "persistent-workspaces": {
      "*": 6
    }
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 40,
    "separate-outputs": false
  },

  "clock": {
    "format": "{:%a %b %d  %I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%Y-%m-%d}"
  },

  "battery": {
    "interval": 1,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-full": "󰁹 Full",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{capacity}%, {timeTo}"
  },

  "network": {
    "interval": 5,
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}"
  },

  "custom/volume": {
    "exec": "volume-ctl status",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "on-click": "volume-ctl toggle",
    "on-click-right": "volume-ctl up",
    "on-click-middle": "volume-ctl down",
    "on-scroll-up": "volume-ctl up",
    "on-scroll-down": "volume-ctl down"
  },

  "backlight": {
    "format": "󰃠 {percent}%",
    "on-click": "brightnessctl -e4 -n2 set 5%+",
    "on-click-right": "brightnessctl -e4 -n2 set 5%-",
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
  },

  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{player_icon} {title} (paused)",
    "player-icons": {
      "default": "󰝚",
      "spotify": "󰓇",
      "firefox": "󰗃"
    },
    "max-length": 25,
    "tooltip-format": "{title} - {artist}"
  },

  "custom/window": {
    "exec": "hyprctl activewindow | awk '/title:/{$1=\"\"; print substr($0,2)}'",
    "interval": 1,
    "format": "{}",
    "max-length": 40
  }
}
